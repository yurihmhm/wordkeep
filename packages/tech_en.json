{"id":"tech_en","v":1,"title":{"ja":"IT・テックの英単語","en":"IT and Tech English Words","zh":"IT・科技英语单词","fr":"Vocabulaire anglais de l’informatique","ar":"مفردات إنجليزية في تقنية المعلومات","ko":"IT·테크 영단어","ru":"Английские слова из сферы IT"},"words":[{"word":"server","pos":"noun","meaning":{"ja":"サーバー","en":"a computer that provides data or services to others","zh":"服务器","fr":"serveur","ar":"خادم","ko":"서버","ru":"сервер"}},{"word":"client","pos":"noun","meaning":{"ja":"クライアント／依頼主","en":"a computer or person that requests a service","zh":"客户端／客户","fr":"client","ar":"عميل","ko":"클라이언트/의뢰인","ru":"клиент"}},{"word":"database","pos":"noun","meaning":{"ja":"データベース","en":"an organised store of information","zh":"数据库","fr":"base de données","ar":"قاعدة بيانات","ko":"데이터베이스","ru":"база данных"}},{"word":"network","pos":"noun","meaning":{"ja":"ネットワーク","en":"computers connected so they can share data","zh":"网络","fr":"réseau","ar":"شبكة","ko":"네트워크","ru":"сеть"}},{"word":"browser","pos":"noun","meaning":{"ja":"ブラウザ","en":"a program for viewing websites","zh":"浏览器","fr":"navigateur","ar":"متصفّح","ko":"브라우저","ru":"браузер"}},{"word":"device","pos":"noun","meaning":{"ja":"端末／機器","en":"a piece of equipment such as a phone or laptop","zh":"设备","fr":"appareil","ar":"جهاز","ko":"기기/단말","ru":"устройство"}},{"word":"software","pos":"noun","meaning":{"ja":"ソフトウェア","en":"the programs a computer runs","zh":"软件","fr":"logiciel","ar":"برمجيات","ko":"소프트웨어","ru":"программное обеспечение"}},{"word":"hardware","pos":"noun","meaning":{"ja":"ハードウェア","en":"the physical parts of a computer","zh":"硬件","fr":"matériel","ar":"عتاد","ko":"하드웨어","ru":"аппаратное обеспечение"}},{"word":"storage","pos":"noun","meaning":{"ja":"保存領域／ストレージ","en":"space where data is kept","zh":"存储","fr":"stockage","ar":"تخزين","ko":"저장 공간","ru":"хранилище"}},{"word":"memory","pos":"noun","meaning":{"ja":"メモリ","en":"the part of a computer that holds data while it works","zh":"内存","fr":"mémoire","ar":"ذاكرة","ko":"메모리","ru":"память"}},{"word":"file","pos":"noun","meaning":{"ja":"ファイル","en":"a named collection of data","zh":"文件","fr":"fichier","ar":"ملف","ko":"파일","ru":"файл"}},{"word":"folder","pos":"noun","meaning":{"ja":"フォルダ","en":"a container that holds files","zh":"文件夹","fr":"dossier","ar":"مجلد","ko":"폴더","ru":"папка"}},{"word":"backup","pos":"noun","meaning":{"ja":"バックアップ","en":"a spare copy kept in case the original is lost","zh":"备份","fr":"sauvegarde","ar":"نسخة احتياطية","ko":"백업","ru":"резервная копия"}},{"word":"update","pos":"noun","meaning":{"ja":"更新／アップデート","en":"a newer version of software","zh":"更新","fr":"mise à jour","ar":"تحديث","ko":"업데이트","ru":"обновление"}},{"word":"install","pos":"verb","meaning":{"ja":"インストールする","en":"to put software onto a device so it can run","zh":"安装","fr":"installer","ar":"يُثبّت","ko":"설치하다","ru":"устанавливать"}},{"word":"download","pos":"verb","meaning":{"ja":"ダウンロードする","en":"to copy data from the internet to your device","zh":"下载","fr":"télécharger","ar":"يُنزّل","ko":"다운로드하다","ru":"скачивать"}},{"word":"upload","pos":"verb","meaning":{"ja":"アップロードする","en":"to send data from your device to the internet","zh":"上传","fr":"téléverser","ar":"يرفع","ko":"업로드하다","ru":"загружать на сервер"}},{"word":"login","pos":"noun","meaning":{"ja":"ログイン","en":"the act of signing in to an account","zh":"登录","fr":"connexion","ar":"تسجيل الدخول","ko":"로그인","ru":"вход в систему"}},{"word":"password","pos":"noun","meaning":{"ja":"パスワード","en":"a secret word used to prove who you are","zh":"密码","fr":"mot de passe","ar":"كلمة المرور","ko":"비밀번호","ru":"пароль"}},{"word":"account","pos":"noun","meaning":{"ja":"アカウント","en":"a personal record that lets you use a service","zh":"账户","fr":"compte","ar":"حساب","ko":"계정","ru":"учётная запись"}},{"word":"bug","pos":"noun","meaning":{"ja":"バグ／不具合","en":"a mistake that makes a program behave wrongly","zh":"缺陷／错误","fr":"bogue","ar":"خلل برمجي","ko":"버그/결함","ru":"ошибка в программе"}},{"word":"debug","pos":"verb","meaning":{"ja":"デバッグする","en":"to find and remove mistakes in a program","zh":"调试","fr":"déboguer","ar":"ينقّح الأخطاء","ko":"디버그하다","ru":"отлаживать"}},{"word":"code","pos":"noun","meaning":{"ja":"コード／プログラム","en":"the instructions that make up a program","zh":"代码","fr":"code","ar":"شيفرة","ko":"코드","ru":"код"}},{"word":"function","pos":"noun","meaning":{"ja":"関数／機能","en":"a named piece of code, or what something does","zh":"函数／功能","fr":"fonction","ar":"دالة / وظيفة","ko":"함수/기능","ru":"функция"}},{"word":"variable","pos":"noun","meaning":{"ja":"変数","en":"a named place that holds a value","zh":"变量","fr":"variable","ar":"متغيّر","ko":"변수","ru":"переменная"}},{"word":"loop","pos":"noun","meaning":{"ja":"ループ／繰り返し","en":"a part of a program that repeats","zh":"循环","fr":"boucle","ar":"حلقة تكرار","ko":"루프/반복","ru":"цикл"}},{"word":"array","pos":"noun","meaning":{"ja":"配列","en":"an ordered list of values","zh":"数组","fr":"tableau","ar":"مصفوفة","ko":"배열","ru":"массив"}},{"word":"string","pos":"noun","meaning":{"ja":"文字列","en":"a piece of text in a program","zh":"字符串","fr":"chaîne de caractères","ar":"سلسلة نصية","ko":"문자열","ru":"строка"}},{"word":"library","pos":"noun","meaning":{"ja":"ライブラリ","en":"ready-made code you can reuse","zh":"库","fr":"bibliothèque","ar":"مكتبة برمجية","ko":"라이브러리","ru":"библиотека"}},{"word":"framework","pos":"noun","meaning":{"ja":"フレームワーク","en":"a structure that programs are built on","zh":"框架","fr":"cadriciel","ar":"إطار عمل","ko":"프레임워크","ru":"фреймворк"}},{"word":"interface","pos":"noun","meaning":{"ja":"インターフェース","en":"the point where two things connect or interact","zh":"接口／界面","fr":"interface","ar":"واجهة","ko":"인터페이스","ru":"интерфейс"}},{"word":"feature","pos":"noun","meaning":{"ja":"機能","en":"something a product can do","zh":"功能","fr":"fonctionnalité","ar":"ميزة","ko":"기능","ru":"возможность"}},{"word":"release","pos":"noun","meaning":{"ja":"リリース／公開","en":"a version made available to users","zh":"发布","fr":"version publiée","ar":"إصدار","ko":"릴리스/출시","ru":"выпуск"}},{"word":"version","pos":"noun","meaning":{"ja":"バージョン","en":"one particular form of something that changes over time","zh":"版本","fr":"version","ar":"إصدار / نسخة","ko":"버전","ru":"версия"}},{"word":"deploy","pos":"verb","meaning":{"ja":"デプロイする／配備する","en":"to put software into use on a server","zh":"部署","fr":"déployer","ar":"ينشر للتشغيل","ko":"배포하다","ru":"развёртывать"}},{"word":"server-side","pos":"adj","meaning":{"ja":"サーバー側の","en":"happening on the server rather than the user’s device","zh":"服务端的","fr":"côté serveur","ar":"من جهة الخادم","ko":"서버 측의","ru":"серверный"}},{"word":"encrypt","pos":"verb","meaning":{"ja":"暗号化する","en":"to scramble data so only the right person can read it","zh":"加密","fr":"chiffrer","ar":"يشفّر","ko":"암호화하다","ru":"шифровать"}},{"word":"security","pos":"noun","meaning":{"ja":"セキュリティ／安全性","en":"protection against attack or misuse","zh":"安全性","fr":"sécurité","ar":"أمن","ko":"보안","ru":"безопасность"}},{"word":"permission","pos":"noun","meaning":{"ja":"権限／許可","en":"the right to do something in a system","zh":"权限","fr":"autorisation","ar":"إذن / صلاحية","ko":"권한/허가","ru":"разрешение"}},{"word":"access","pos":"noun","meaning":{"ja":"アクセス／利用権","en":"the ability to reach or use something","zh":"访问权","fr":"accès","ar":"وصول","ko":"접근/이용 권한","ru":"доступ"}},{"word":"query","pos":"noun","meaning":{"ja":"問い合わせ／クエリ","en":"a request for information from a database","zh":"查询","fr":"requête","ar":"استعلام","ko":"질의/쿼리","ru":"запрос"}},{"word":"request","pos":"noun","meaning":{"ja":"リクエスト／要求","en":"a message asking a server to do something","zh":"请求","fr":"requête","ar":"طلب","ko":"요청","ru":"запрос"}},{"word":"response","pos":"noun","meaning":{"ja":"レスポンス／応答","en":"what a server sends back","zh":"响应","fr":"réponse","ar":"استجابة","ko":"응답","ru":"ответ"}},{"word":"cache","pos":"noun","meaning":{"ja":"キャッシュ","en":"a temporary store that makes repeat access faster","zh":"缓存","fr":"cache","ar":"ذاكرة مؤقتة","ko":"캐시","ru":"кэш"}},{"word":"latency","pos":"noun","meaning":{"ja":"遅延／レイテンシ","en":"the delay before data arrives","zh":"延迟","fr":"latence","ar":"زمن الاستجابة","ko":"지연 시간","ru":"задержка"}},{"word":"bandwidth","pos":"noun","meaning":{"ja":"帯域幅","en":"how much data a connection can carry","zh":"带宽","fr":"bande passante","ar":"عرض النطاق","ko":"대역폭","ru":"пропускная способность"}},{"word":"scalable","pos":"adj","meaning":{"ja":"拡張性のある","en":"able to handle growth without breaking","zh":"可扩展的","fr":"évolutif","ar":"قابل للتوسّع","ko":"확장 가능한","ru":"масштабируемый"}},{"word":"deprecated","pos":"adj","meaning":{"ja":"非推奨の","en":"kept working for now but no longer recommended","zh":"已弃用的","fr":"obsolète","ar":"مهجور / غير موصى به","ko":"더 이상 권장되지 않는","ru":"устаревший"}},{"word":"repository","pos":"noun","meaning":{"ja":"リポジトリ／保管場所","en":"a store where code and its history are kept","zh":"仓库","fr":"dépôt","ar":"مستودع","ko":"저장소","ru":"репозиторий"}},{"word":"commit","pos":"noun","meaning":{"ja":"コミット／変更の記録","en":"one saved set of changes to code","zh":"提交","fr":"commit","ar":"التزام / حفظ تغييرات","ko":"커밋","ru":"коммит"}}]}