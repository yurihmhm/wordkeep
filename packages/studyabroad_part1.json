"pos":"verb","meaning":{"ja":"改善する、上達させる","en":"to make or become better","zh":"提高","fr":"améliorer","ar":"يحسّن","ko":"향상시키다","ru":"улучшать"}},{"word":"submit","pos":"verb","meaning":{"ja":"提出する","en":"to hand in work for checking","zh":"提交","fr":"soumettre / rendre","ar":"يقدّم / يسلّم","ko":"제출하다","ru":"сдавать / представлять"}},{"word":"correct","pos":"adjective","meaning":{"ja":"正しい","en":"right or accurate","zh":"正确的","fr":"correct(e)","ar":"صحيح","ko":"맞는/정확한","ru":"правильный"}},{"word":"incorrect","pos":"adjective","meaning":{"ja":"間違っている","en":"wrong","zh":"不正确的","fr":"incorrect(e)","ar":"غير صحيح","ko":"틀린","ru":"неправильный"}},{"word":"similar","pos":"adjective","meaning":{"ja":"似ている","en":"alike in some way","zh":"相似的","fr":"similaire","ar":"مشابه","ko":"비슷한","ru":"похожий"}},{"word":"different","pos":"adjective","meaning":{"ja":"異なる","en":"not the same","zh":"不同的","fr":"différent(e)","ar":"مختلف","ko":"다른","ru":"другой / отличающийся"}},{"word":"formal","pos":"adjective","meaning":{"ja":"フォーマルな、改まった","en":"proper and following set rules, not casual","zh":"正式的","fr":"formel(le)","ar":"رسمي","ko":"격식 있는","ru":"формальный / официальный"}},{"word":"casual","pos":"adjective","meaning":{"ja":"カジュアルな、日常的な","en":"relaxed and informal","zh":"随意的","fr":"décontracté(e)","ar":"غير رسمي","ko":"캐주얼한/일상적인","ru":"непринуждённый / повседневный"}},{"word":"natural","pos":"adjective","meaning":{"ja":"自然な","en":"normal, not forced","zh":"自然的","fr":"naturel(le)","ar":"طبيعي","ko":"자연스러운","ru":"естественный"}},{"word":"specific","pos":"adjective","meaning":{"ja":"具体的な、特定の","en":"exact and particular","zh":"具体的","fr":"spécifique","ar":"محدد","ko":"구체적인","ru":"конкретный"}},{"word":"confusing","pos":"adjective","meaning":{"ja":"分かりにくい、混乱させる","en":"hard to understand","zh":"令人困惑的","fr":"déroutant(e)","ar":"مربك","ko":"헷갈리는","ru":"запутанный"}},{"word":"fluent","pos":"adjective","meaning":{"ja":"流暢な","en":"able to speak smoothly and easily","zh":"流利的","fr":"courant(e)","ar":"طلق/بطلاقة","ko":"유창한","ru":"свободно владеющий (языком)"}},{"word":"actually","pos":"adverb","meaning":{"ja":"実は／実際には","en":"in fact, really","zh":"实际上","fr":"en fait","ar":"في الواقع","ko":"사실은","ru":"на самом деле"}},{"word":"probably","pos":"adverb","meaning":{"ja":"おそらく","en":"most likely","zh":"可能","fr":"probablement","ar":"على الأرجح","ko":"아마도","ru":"вероятно"}},{"word":"instead","pos":"adverb","meaning":{"ja":"代わりに","en":"in place of something else","zh":"而是","fr":"à la place / au lieu de cela","ar":"بدلاً من ذلك","ko":"대신에","ru":"вместо (этого)"}},{"word":"although","pos":"conjunction","meaning":{"ja":"〜だけれども","en":"despite the fact that","zh":"虽然","fr":"bien que","ar":"على الرغم من أن","ko":"비록 ~이지만","ru":"хотя"}},{"word":"during","pos":"preposition","meaning":{"ja":"〜の間に","en":"throughout a period of time","zh":"在…期间","fr":"pendant","ar":"خلال","ko":"~동안","ru":"во время"}}]}