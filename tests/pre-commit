#!/bin/sh
# Wordkeep pre-commit check.
#
# Installed to .git/hooks/pre-commit (that directory is not tracked by git, so
# the master copy lives here). Reinstall with:
#   cd "/Users/yuri_hmhm/Desktop/Claude Code/WordKeep" && sh tests/install-hooks.sh
#
# Blocks the commit if index.html has a syntax error or the logic tests fail.
# The point is that nobody -- human or assistant -- has to remember to run it.

changed() { git diff --cached --name-only | grep -qx "$1"; }

pkg_changed() { git diff --cached --name-only | grep -q '^packages/'; }

# Nothing relevant staged? Nothing to check.
notify_changed() { git diff --cached --name-only | grep -qE '^(service-worker\.js|tools/send-reminders\.mjs|tests/(notify|slots)\.test\.mjs)$'; }

if ! changed index.html && ! changed tests/logic.test.js && ! changed tests/extract.mjs \
   && ! pkg_changed && ! notify_changed; then
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 1

echo "pre-commit: checking index.html syntax..."
python3 - <<'PY' || exit 1
import io,sys
s=io.open('index.html',encoding='utf-8').read()
io.open('/tmp/wk-precommit.js','w',encoding='utf-8').write(
    s[s.rindex('<script>')+8:s.rindex('</script>')])
PY
node --check /tmp/wk-precommit.js || {
  echo ""
  echo "BLOCKED: index.html has a JavaScript syntax error (see above)."
  exit 1
}

echo "pre-commit: running logic tests..."
# extract.mjs regenerates the tested code from index.html, so the suite can
# never pass against a stale copy.
( cd tests && node extract.mjs >/dev/null && node logic.test.js ) || {
  echo ""
  echo "BLOCKED: logic tests failed. Fix them, or use --no-verify if you"
  echo "genuinely mean to commit a known-failing state."
  exit 1
}

# The notification wording is the one part of the app nobody can see while
# working on it -- it renders on a locked phone, hours later, from state that
# has to be simulated. So it is the part that most needs a test.
echo "pre-commit: running notification tests..."
node tests/notify.test.mjs >/dev/null && node tests/slots.test.mjs >/dev/null || {
  echo ""
  echo "BLOCKED: notification tests failed. Run them directly to see which:"
  echo "  node tests/notify.test.mjs && node tests/slots.test.mjs"
  exit 1
}

# The catalogue in index.html and packages/*.json have to agree: the app trusts
# `count` for the progress bar before the words are downloaded, and a mismatched
# version means the file is re-fetched on every open.
echo "pre-commit: checking package files..."
# --check, so the hook never rewrites index.html after it was staged: the
# commit would then contain something other than what was verified.
node tests/build-packages.mjs --check || {
  echo ""
  echo "BLOCKED: the package catalogue and packages/*.json disagree (see above)."
  echo "Run 'node tests/build-packages.mjs' and stage index.html."
  exit 1
}

echo "pre-commit: ok"
exit 0
