rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The admin account (Wordkeep管理ページ用)
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == '5shCkAHirbgDVrkDmcM0KNr0ouq1';
    }

    // A nickname can only be changed once every 7 days. The app checks this
    // too, but that check is one devtools console away from being bypassed --
    // this is the copy that actually holds.
    function nicknameUnchanged() {
      // `allow write` also covers deletes, and on a delete request.resource is
      // null -- reading .data off it throws, and a rule that throws denies.
      // Without this guard an owner could never delete their own document.
      return request.resource == null
             || !('nickname' in request.resource.data)
             || (resource != null
                 && 'nickname' in resource.data
                 && request.resource.data.nickname == resource.data.nickname);
    }
    function nicknameAllowed() {
      return nicknameUnchanged()
             // first time it is ever set: nothing to cool down from
             || resource == null
             || !('nicknameAt' in resource.data)
             || request.time.toMillis() >= resource.data.nicknameAt + 604800000;
    }

    match /users/{userId} {
      // Each user owns their own document and everything under it.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && nicknameAllowed();

      // The admin can read the summary document (nickname, login id, word
      // count, streak, last update) so the admin page can list accounts, and
      // delete it to clear out an abandoned or spam account. Deliberately NOT
      // extended to reading the words subcollection below: managing accounts
      // does not require reading what people are studying.
      allow read, delete: if isAdmin();

      // Forcing a rename. The in-app word list only screens people who have not
      // edited it out of their own copy, and a nickname now shows on a public
      // leaderboard where the 7-day cooldown would leave a bad one up for a
      // week. Restricted to the nickname and the timestamp so this cannot be
      // used to touch a person's streak, decks or word ids.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['nickname','updatedAt'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 60;

      // Deleting an account's data has to reach its word documents too --
      // otherwise removing someone from Authentication leaves their words in
      // Firestore forever, unreachable and still counted. `delete` is granted
      // on its own: Firestore does not require read access to delete a
      // document by id, and the admin page gets those ids from `wordIds` on
      // the summary document. So the admin can remove the words without being
      // able to read a single one of them.
      // Subcollections are listed explicitly. There used to be a
      // `match /{document=**}` here, and it was a trap: under rules_version 2
      // a recursive wildcard matches ZERO or more segments, so it also covered
      // this parent document and granted an unconditional write. Permissions
      // are OR'd, so that permissive rule silently cancelled the nickname
      // cooldown above -- renames went through instantly. Verified with the
      // emulator. Naming the subcollection also means any future one is denied
      // by default rather than exposed by accident.
      match /words/{wordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow delete: if isAdmin();
      }
    }

    // ---- Leaderboard ------------------------------------------------------
    // One small public document per participant. It holds only what the board
    // shows -- a nickname and a handful of counters -- never any vocabulary.
    // Anyone signed in can read the whole collection, because that is what a
    // leaderboard is; only the owner can write their own row.
    //
    // These numbers come from the client, so they are trusted only as far as
    // the client is. Validating them here bounds the damage (no strings where
    // numbers belong, no negative or absurd values, no extra fields used as
    // free storage) but it cannot prove someone actually did the reviews.
    // Making that airtight needs a server recomputing from word history, which
    // is a Cloud Function and a different piece of work.
    function boardNum(field, max) {
      return field in request.resource.data
             && request.resource.data[field] is int
             && request.resource.data[field] >= 0
             && request.resource.data[field] <= max;
    }
    match /board/{userId} {
      allow read: if request.auth != null;
      allow delete: if (request.auth != null && request.auth.uid == userId)
                    || isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(
                        ['nickname','todayN','todayIdx','totalN','words',
                         'streak','best','days','at'])
                   && request.resource.data.nickname is string
                   && request.resource.data.nickname.size() > 0
                   && request.resource.data.nickname.size() <= 60
                   && boardNum('todayN', 100000)
                   && boardNum('todayIdx', 1000000)
                   && boardNum('totalN', 100000000)
                   && boardNum('words', 1000000)
                   && boardNum('streak', 100000)
                   && boardNum('best', 100000)
                   && boardNum('days', 100000)
                   && boardNum('at', 99999999999999);
    }

    // ---- Push subscriptions -----------------------------------------------
    // One document per account, holding only what is needed to deliver a push:
    // the address the browser's push service handed out, its two keys, the
    // local hours to fire at, and the timezone. Deliberately NOT the words --
    // the push is sent empty and the service worker writes the text on the
    // device, so the sender never learns what anybody is studying.
    //
    // Nobody can read these back from the client. The scheduled sender uses the
    // Admin SDK, which bypasses rules; leaving read closed means a subscription
    // endpoint cannot be harvested by another signed-in user and used to spam
    // that person's browser.
    match /push/{userId} {
      allow read: if false;
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(
                        ['endpoint','p256dh','auth','hours','studyMin','eveningHour',
                         'lastCallHour','lastDay','hasStreak','tzOffset','at'])
                   // A refresh of just the study time is a merge, so the
                   // endpoint and keys are absent from that write.
                   && (!('endpoint' in request.resource.data)
                       || (request.resource.data.endpoint is string
                           && request.resource.data.endpoint.size() > 0
                           && request.resource.data.endpoint.size() < 1000))
                   && (!('p256dh' in request.resource.data) || request.resource.data.p256dh is string)
                   && (!('auth' in request.resource.data) || request.resource.data.auth is string)
                   && (!('hours' in request.resource.data)
                       || (request.resource.data.hours is list
                           && request.resource.data.hours.size() <= 6))
                   && (!('studyMin' in request.resource.data)
                       || (request.resource.data.studyMin is int
                           && request.resource.data.studyMin >= 0
                           && request.resource.data.studyMin <= 1439))
                   && (!('eveningHour' in request.resource.data)
                       || (request.resource.data.eveningHour is int
                           && request.resource.data.eveningHour >= 0
                           && request.resource.data.eveningHour <= 23))
                   && (!('lastCallHour' in request.resource.data)
                       || (request.resource.data.lastCallHour is int
                           && request.resource.data.lastCallHour >= 0
                           && request.resource.data.lastCallHour <= 23))
                   // Which local day they last studied, so a reminder can be
                   // skipped on a day already done. -1 means "never". Bounded
                   // so a bad value cannot become a date far in the future and
                   // silence the reminders forever.
                   && (!('lastDay' in request.resource.data)
                       || (request.resource.data.lastDay is int
                           && request.resource.data.lastDay >= -1
                           && request.resource.data.lastDay <= 100000))
                   // Whether there IS a run. Never how long it is.
                   && (!('hasStreak' in request.resource.data)
                       || request.resource.data.hasStreak is bool)
                   && (!('tzOffset' in request.resource.data)
                       || (request.resource.data.tzOffset is int
                           && request.resource.data.tzOffset >= -840
                           && request.resource.data.tzOffset <= 840))
                   && request.resource.data.at is int;
    }

    // ---- Error reports ----------------------------------------------------
    // Anyone may file one, including signed-out visitors -- an error that stops
    // sign-in is exactly the kind worth hearing about. Only the admin reads
    // them back.
    //
    // The size caps are the collection's only defence against being used as
    // free storage; the client rate-limits itself, but a client is not a
    // control.
    match /errors/{id} {
      allow create: if request.resource.data.msg is string
                    && request.resource.data.msg.size() > 0
                    && request.resource.data.msg.size() <= 300
                    && request.resource.data.keys().hasOnly(
                         ['msg','stack','src','line','col','v','ua','lang','uid','at'])
                    && (!('stack' in request.resource.data)
                        || request.resource.data.stack.size() <= 1200)
                    && request.resource.data.at is int;
      allow read, delete: if isAdmin();
    }

    match /feedback/{id} {
      // Anyone can send feedback, including signed-out users, but the payload
      // is capped so the collection can't be used as free storage.
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 2000;
      // Only the admin can read it back, mark it handled, or delete it.
      allow read, update, delete: if isAdmin();
    }
  }
}
